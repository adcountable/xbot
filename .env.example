# X (Twitter) API — free tier at developer.twitter.com
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=

# Gmail — use an App Password (not your real password)
# Enable at: myaccount.google.com/apppasswords
EMAIL_FROM=you@gmail.com
EMAIL_APP_PASSWORD=

# Your T-Mobile number, 10 digits no dashes e.g. 2125551234
PHONE_NUMBER=

# Schedule
POST_TIMES=08:00,13:00,19:00
DIGEST_TIME=07:00
